<?xml version="1.0"?>
<package format="2">
  <name>rfid_simulator_test</name>
  <version>0.0.0</version>
  <description>Package to test the functionalities of the RFID Gazebo plugin</description>
  <author email="salvatore.davella@santannapisa.it">Salvatore D'Avella</author>
  <maintainer email="salvatore.davella@santannapisa.it">Salvatore D'Avella</maintainer>

  <license>GNU GPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rfid_sensor</depend>
  <build_depend>gazebo_dev</build_depend>
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="lib"/>
  </export>
</package>
